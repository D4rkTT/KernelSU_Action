# KernelSU Action -- build profile for OnePlus Nord CE 2 Lite 5G (CPH2409)
# Device Codename: oscar

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/D4rkTT/android_kernel_msm-5.4_oneplus_sm6375
KERNEL_SOURCE_BRANCH=oneplus/sm6375_u_14.0.0_nord_ce_2_lite_5g
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false

KERNEL_NAME=nord-ce-2-lite


# =================================================================== Clang ==
# Since your device runs a 5.4 kernel, use the main-kernel-2025 toolchain 
# which is optimized for older 5.x architectures.
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# ReSukiSU targets legacy and non-GKI kernels like your 5.4 tree.
KSU_VARIANT=resukisu-ultima
KSU_REF=main

# Use manual hooks since your 5.4 kernel lacks standard GKI kprobes compatibility
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# Crucial layout configuration. Enables kernel-level cloak mechanics.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# Mandatory for kernels below version 5.9 so ReSukiSU can clean mount states.
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# Force the specific Sentinel config options directly into compilation flags
EXTRA_DEFCONFIG=CONFIG_KSU_SENTINEL=y

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true

# Point the builder directly to the Ultima repository branch
EXTRA_CMDS:KSU_EXPECTED_HASH=none
